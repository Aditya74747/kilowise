# Copy to .env (never commit .env). Only needed for the optional chatbot / ML features (docs/).
# GL_CHAT_PROVIDER=local        # local = fine-tuned small model on this machine | none = retrieval-only answers
# GL_CHAT_MODEL=                # base model id or local path (default Qwen/Qwen2.5-1.5B-Instruct); the LoRA adapter
#                               # in models/chat-lora/ is applied if its evaluation kept it
# GL_EMBED_MODEL=               # embedding model for retrieval (default sentence-transformers/all-MiniLM-L6-v2)
# ---- Connectors (Data sources > Connect your accounts). Read-only credentials; never commit .env. ----
# AWS Cost Explorer: an IAM user/role allowed only ce:GetCostAndUsage (or set AWS_PROFILE instead)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Azure Cost Management + Microsoft 365 licences: an Entra ID app with Cost Management Reader / Graph Organization.Read.All
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# OpenAI usage and costs: an organization admin key
# OPENAI_ADMIN_KEY=
# Claude usage and cost: an Admin API key (sk-ant-admin...)
# ANTHROPIC_ADMIN_KEY=
# HF_HOME=                      # where Hugging Face caches the downloaded models (default: the user's cache folder)
