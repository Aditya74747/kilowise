data/raw/external/reference/*.pdf
data/raw/external/reference/ember_*.csv

# Upload workspace of `greenledger serve` (another company's exports and their outputs)
workspace/

# ---- Public GitHub repository: keep dot-files and assistant notes out ----
# The case data (synthetic, free to use: sample data ALTYCA, sprintd Basel 2026) and the Grid page's open data
# (Ember and Energy-Charts CC BY 4.0, Natural Earth public domain) are committed, so a fresh clone builds everything
# Dot-files and dot-folders (editor, tool and environment settings); only this file stays
.*
!.gitignore
!.env.example
!.nojekyll
# Notes for the coding assistant
CLAUDE.md
**/CLAUDE.md

# Pitch demo video (about 35 MB; rebuild with tools/video/record_demo.py, share it separately)
pitch/assets/*.mp4
!pitch/assets/kilowise_demo_voice.mp4
pitch_video/
